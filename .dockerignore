# Git és verziókövetés
.git
.gitignore
.gitattributes

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtuális környezet
venv/
env/
.venv/
ENV/

# Helyi adatbázis (prod PostgreSQL-t fog használni)
*.db
*.sqlite
*.sqlite3

# Helyi feltöltések (volume-ból jön majd)
static/uploads/*
!static/uploads/.gitkeep

# Környezeti változók (secrets set-tel adjuk meg)
.env
.env.*
!.env.example

# Fejlesztési és IDE fájlok
.vscode/
.idea/
*.swp
*.swo
*~

# OS fájlok
.DS_Store
Thumbs.db
Desktop.ini

# Dokumentáció (nem kell a Docker image-be)
README.md

# Logok
*.log
